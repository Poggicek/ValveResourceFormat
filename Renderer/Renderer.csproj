<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>OpenGL-based rendering engine for Source 2 game assets. Supports models, maps, materials, particles, and animations with PBR lighting.</Description>
    <PackageId>ValveResourceFormat.Renderer</PackageId>
    <PackageReleaseNotes>View release notes at https://github.com/ValveResourceFormat/ValveResourceFormat/releases</PackageReleaseNotes>
    <PackageIcon>source2viewer.png</PackageIcon>
    <PackageTags>source2 dota2 dota steam valve halflife artifact underlords</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishAot Condition="'$(Configuration)' != 'Debug'">true</PublishAot>
    <IsAotCompatible Condition="'$(Configuration)' != 'Debug'">true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Silk.NET.Core's DefaultPathResolver reads Assembly.Location and DependencyContext.Default,
         which are unavailable in a single-file bundle. Its deps.json native lookup is therefore dead
         there and the plain OS library search finds vulkan-1.dll instead, which is why every runtime
         probe passes. Only these two single-file diagnostics are exempted; the trim (IL2xxx) and AOT
         (IL3050/IL3051) gates stay armed. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL3000;IL3002</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\Misc\Icons\source2viewer.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ValveResourceFormat.Utils" />
    <Using Include="ValveResourceFormat.Renderer.Utils" />
    <Using Include="ValveResourceFormat.Renderer.Shaders" />
    <Using Include="ValveResourceFormat.Renderer.Materials" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\**" />
    <EmbeddedResource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyMetadata Include="ShaderSourceDirectory" Value="$(MSBuildProjectDirectory)\Shaders" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="NLayer" Version="2.0.1" />
    <PackageReference Include="OpenTK.Graphics" Version="4.9.4" />
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ValveResourceFormat\ValveResourceFormat.csproj" />
  </ItemGroup>

</Project>
